load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "logging",
    srcs = ["log.go"],
    importpath = "github.com/discentem/starcm/libraries/logging",
    visibility = ["//visibility:public"],
    deps = ["@com_github_google_deck//:deck"],
)

go_test(
    name = "logging_test",
    srcs = ["log_test.go"],
    embed = [":logging"],
    deps = [
        "@com_github_google_deck//:deck",
        "@com_github_google_deck//backends/logger",
    ],
)
