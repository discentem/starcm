load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "signing",
    srcs = [
        "manifest.go",
        "signing.go",
    ],
    importpath = "github.com/discentem/starcm/libraries/signing",
    visibility = ["//visibility:public"],
    deps = [
        "//libraries/sha256",
        "@com_github_mitchellh_go_homedir//:go-homedir",
        "@com_github_spf13_afero//:afero",
    ],
)

go_test(
    name = "signing_test",
    srcs = [
        "manifest_test.go",
        "signing_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":signing"],
    deps = [
        "//libraries/sha256",
        "@com_github_spf13_afero//:afero",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
